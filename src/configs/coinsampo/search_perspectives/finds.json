                        },
                        {
                            "id": "bar",
                            "createChartData": "createApexBarChartData"
                        }
                    ]
                }
            }
        },
        "csvFinds": {
            "tabID": 10,
            "tabPath": "csv",
            "tabIcon": "CloudDownload",
            "component": "ExportCSV",
            "facetClass": "finds",
            "sparqlQuery": "findsCSVQuery",
            "filterTarget": "id"
        },
        "findsKnowledgeGraphMetadata": {
            "sparqlQuery": "knowledgeGraphMetadataQuery",
